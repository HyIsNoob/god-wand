{
  "targets": [
    "dom_scene",
    {"name": "dom_emit", "width": 1, "height": 1},
    {"name": "dom_blur_x", "width": 1, "height": 1},
    {"name": "dom_blur_y", "width": 1, "height": 1}
  ],
  "passes": [
    {
      "name": "color_convolve",
      "intarget": "minecraft:main",
      "outtarget": "dom_emit",
      "use_linear_filter": true,
      "uniforms": [
        {"name": "ColorScale", "values": [2.0, 2.0, 2.0]},
        {"name": "Offset", "values": [-1.15, -1.15, -1.15]},
        {"name": "Saturation", "values": [1.35]}
      ]
    },
    {
      "name": "godwand_bloom",
      "intarget": "dom_emit",
      "outtarget": "dom_blur_x",
      "uniforms": [{"name": "BlurAxis", "values": [1.0, 0.0]}],
      "use_linear_filter": true
    },
    {
      "name": "godwand_bloom",
      "intarget": "dom_blur_x",
      "outtarget": "dom_blur_y",
      "uniforms": [{"name": "BlurAxis", "values": [0.0, 1.0]}],
      "use_linear_filter": true
    },
    {
      "name": "godwand_bloom",
      "intarget": "dom_blur_y",
      "outtarget": "dom_blur_x",
      "uniforms": [{"name": "BlurAxis", "values": [1.0, 0.0]}],
      "use_linear_filter": true
    },
    {
      "name": "godwand_bloom",
      "intarget": "dom_blur_x",
      "outtarget": "dom_blur_y",
      "uniforms": [{"name": "BlurAxis", "values": [0.0, 1.0]}],
      "use_linear_filter": true
    },
    {
      "name": "godwand_nova_composite",
      "intarget": "minecraft:main",
      "outtarget": "dom_scene",
      "auxtargets": [{"name": "BloomSampler", "id": "dom_blur_y", "bilinear": true}]
    },
    {
      "name": "godwand_dominion_fx",
      "intarget": "dom_scene",
      "outtarget": "minecraft:main"
    }
  ]
}
